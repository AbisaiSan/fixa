[Unit]
Description=Fixa, fila (homologação)
After=network.target postgresql.service redis-server.service clamav-daemon.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/fixa
# Mesmos parâmetros do docker/8.5/supervisord.conf.
ExecStart=/usr/bin/php8.5 artisan queue:work --sleep=2 --tries=4 --timeout=300 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
